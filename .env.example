# Настройки для локального запуска вне Docker (uv run ...): cp .env.example .env
ENVIRONMENT=Local
LOG_LEVEL=INFO
API_KEY=change-me

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=payments

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

PAYMENT_MAX_ATTEMPTS=3
PAYMENT_RETRY_BASE_DELAY=1.0

GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
GATEWAY_SUCCESS_RATE=0.9

WEBHOOK_TIMEOUT=5
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1.0

# Порты на хосте для docker compose (если стандартные заняты)
POSTGRES_HOST_PORT=5432
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
API_HOST_PORT=8000
WEBHOOK_RECEIVER_HOST_PORT=8081
